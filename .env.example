# Names and placeholders only. Nothing here is needed for `npm run verify`, which is credential-free.
# The full, commented environment contracts live with each deployable:
#   packages/recruiter-mcp/deploy/production.env.example   (recruiter server, mounted write plane, OAuth)
#   packages/action-mcp/deploy/production.env.example      (write-plane install and reconciler)

# Greenhouse Harvest v3 OAuth client (read). Used by the control plane and the recruiter server.
GREENHOUSE_CLIENT_ID=<greenhouse-client-id>
GREENHOUSE_CLIENT_SECRET=<greenhouse-client-secret>

# The dedicated Supabase project that holds identity, revocation, OAuth grants, and the action ledger.
GREENHOUSE_MCP_SUPABASE_PROJECT_REF=<supabase-project-ref>
GREENHOUSE_RECRUITER_IDENTITY_SUPABASE_URL=https://<supabase-project-ref>.supabase.co
GREENHOUSE_RECRUITER_IDENTITY_SUPABASE_KEY=<server-side-supabase-key>
GREENHOUSE_RECRUITER_REVOCATION_SUPABASE_URL=https://<supabase-project-ref>.supabase.co
GREENHOUSE_RECRUITER_REVOCATION_SUPABASE_KEY=<server-side-supabase-key>

# Signing secrets: 32+ high-entropy characters each, all distinct.
GREENHOUSE_RECRUITER_SESSION_SECRET=<random-secret>
GREENHOUSE_RECRUITER_SCOPE_SIGNING_SECRET=<random-secret>
GREENHOUSE_RECRUITER_OAUTH_SIGNING_SECRET=<random-secret>
GREENHOUSE_ACTION_SIGNING_SECRET=<random-secret>

# Google sign-in for the OAuth connector flow, and the work-email domains it accepts.
GREENHOUSE_RECRUITER_OAUTH_GOOGLE_CLIENT_ID=<google-oauth-client-id>
GREENHOUSE_RECRUITER_OAUTH_GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GREENHOUSE_RECRUITER_ALLOWED_EMAIL_DOMAINS=example.com

# Write plane: both switches default off.
GREENHOUSE_ACTION_SERVICE_ENABLED=false
GREENHOUSE_ACTION_WRITES_ENABLED=false
