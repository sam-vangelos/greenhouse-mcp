# Independent action-service controls. Both default false in code.
GREENHOUSE_ACTION_SERVICE_ENABLED=false
GREENHOUSE_ACTION_WRITES_ENABLED=false

# Catalog and apply allowlists. Values are exact comma-separated action kinds with no spaces.
# Omit GREENHOUSE_ACTION_CAPABILITIES to expose all 11 pairs. The explicit list makes the
# intended production catalog reviewable. Start with an empty write list; add one canary
# capability at a time, then set the full list after acceptance.
GREENHOUSE_ACTION_CAPABILITIES=application_assignment_change,job_owner_change,application_stage_move,application_rejection,application_unreject,candidate_note_create,job_note_change,application_attribution_change,candidate_record_update,offer_create,offer_update
GREENHOUSE_ACTION_WRITE_CAPABILITIES=

# HTTP listener and optional non-Render build identity. Render supplies RENDER_GIT_COMMIT.
GREENHOUSE_ACTION_MCP_PORT=3334
GREENHOUSE_ACTION_BUILD_SHA=<exact-deployed-git-sha>

# Action-only HMAC secret (at least 32 high-entropy bytes). Reuse the prior assignment-action
# secret during an upgrade so legacy action sessions remain valid. Never reuse a read-session secret.
GREENHOUSE_ACTION_SIGNING_SECRET=<action-only-signing-secret>

# Install-time credential only. Keep it secret and out of the deployed service runtime.
# The access CLI validates this exact URL immediately before psql runs.
GREENHOUSE_ACTION_DATABASE_URL=<canonical-direct-or-pooler-postgresql-url>

# Canonical Greenhouse MCP Supabase project and RLS-bypassing server key.
GREENHOUSE_ACTION_SUPABASE_URL=https://exampleprojectref000.supabase.co
GREENHOUSE_ACTION_SUPABASE_KEY=<service-role-or-sb_secret_key>

# Dedicated Harvest v3 HTTP and reconciler credentials. Use different OAuth client IDs.
# Both may use the exact scope set documented in ../README.md.
GREENHOUSE_ACTION_CLIENT_ID=<dedicated-action-client-id>
GREENHOUSE_ACTION_CLIENT_SECRET=<dedicated-action-client-secret>
GREENHOUSE_ACTION_RECONCILER_CLIENT_ID=<dedicated-reconciler-client-id>
GREENHOUSE_ACTION_RECONCILER_CLIENT_SECRET=<dedicated-reconciler-client-secret>

# service_user is the default. per_human is rejected unless the probe flag is exactly true.
GREENHOUSE_ACTION_ATTRIBUTION_MODE=service_user
GREENHOUSE_ACTION_PER_HUMAN_TOKEN_PROBE_PASSED=false

# Used only by `npm run probe:tokens`; both values must be active Site Admin sandbox users.
GREENHOUSE_ACTION_PROBE_PRIMARY_USER_ID=<sandbox-user-id>
GREENHOUSE_ACTION_PROBE_SECONDARY_USER_ID=<different-sandbox-user-id>
