# Greenhouse recruiter-scoped MCP production server environment.
# Copy this file into your host/orchestrator secret manager and replace placeholders there.
# Do not distribute this file to recruiters. Desktop configs contain only MCP URL + durable user token.

# HTTP listener
GREENHOUSE_RECRUITER_MCP_PORT=3333
GREENHOUSE_RECRUITER_MCP_PATH=/mcp
GREENHOUSE_RECRUITER_HEALTH_PATH=/healthz
GREENHOUSE_RECRUITER_READY_PATH=/readyz
GREENHOUSE_RECRUITER_READYZ_TOKEN=<replace-with-32-plus-character-readiness-bearer-token>

# Greenhouse Harvest organization client. Server-side only.
GREENHOUSE_CLIENT_ID=<greenhouse-client-id>
GREENHOUSE_CLIENT_SECRET=<greenhouse-client-secret>

# Durable session signing secret. Use at least 32 high-entropy characters with no surrounding whitespace.
GREENHOUSE_RECRUITER_SESSION_SECRET=<replace-with-32-plus-character-random-secret>

# Resolver scope artifact signing secret. Use at least 32 high-entropy characters with no surrounding whitespace.
GREENHOUSE_RECRUITER_SCOPE_SIGNING_SECRET=<replace-with-32-plus-character-random-secret>

# Production identity and revocation state backend. Only supabase_postgrest is implemented in this build.
GREENHOUSE_RECRUITER_STATE_BACKEND=supabase_postgrest

# Production identity directory. Server-side only; static GREENHOUSE_RECRUITER_IDENTITY_JSON is pilot-only.
# URL is the canonical Greenhouse MCP project (asserted at runtime). The key must have no surrounding
# whitespace and must be an RLS-bypassing key — a service_role JWT or an sb_secret_ key. The tables have
# row-level security enabled, so an anon/publishable key would read empty results. Table/column overrides
# must be simple identifiers.
GREENHOUSE_RECRUITER_IDENTITY_SUPABASE_URL=https://exampleprojectref000.supabase.co
GREENHOUSE_RECRUITER_IDENTITY_SUPABASE_KEY=<supabase-service-role-or-sb_secret_-key>
GREENHOUSE_RECRUITER_IDENTITY_TABLE=recruiter_identity_directory
GREENHOUSE_RECRUITER_IDENTITY_LOOKUP_TIMEOUT_MS=5000

# Production durable-session revocation source. Server-side only; stores token ids, never token strings.
# URL is the canonical Greenhouse MCP project (asserted at runtime). The key must have no surrounding
# whitespace and must be an RLS-bypassing key — a service_role JWT or an sb_secret_ key — because the
# revocation table has row-level security enabled; an anon/publishable key would read empty results and
# silently fail the session kill-switch (revoked sessions would survive). Overrides must be simple identifiers.
GREENHOUSE_RECRUITER_REVOCATION_SUPABASE_URL=https://exampleprojectref000.supabase.co
GREENHOUSE_RECRUITER_REVOCATION_SUPABASE_KEY=<supabase-service-role-or-sb_secret_-key>
GREENHOUSE_RECRUITER_REVOCATION_TABLE=recruiter_mcp_session_revocation
GREENHOUSE_RECRUITER_REVOCATION_LOOKUP_TIMEOUT_MS=5000

# Retained metadata-only audit sink. Mount/route this path to durable storage.
GREENHOUSE_RECRUITER_AUDIT_JSONL_PATH=/app/audit/audit.jsonl
# Declared durable mount for the audit sink. Readiness fails unless this is set and the audit path
# above resolves under it, so the audit path is routed to the declared durable volume rather than the
# ephemeral container filesystem (where a redeploy would lose the retained PII audit record). NOTE:
# readiness verifies this DECLARATION; confirm the volume is actually mounted at deploy (df / mount).
GREENHOUSE_RECRUITER_AUDIT_DURABLE_MOUNT_PATH=/app/audit

# Remote desktop/broker attachment controls. Unsupported surfaces or malformed origins fail closed.
GREENHOUSE_RECRUITER_REMOTE_SURFACES=chatgpt_desktop,claude_desktop
GREENHOUSE_RECRUITER_CORS_ORIGIN=https://chatgpt.com,https://claude.ai

# Operator unscoped passthrough. Leave empty unless an explicit operator allowlist is approved.
# If set, this must be comma-separated positive Greenhouse user ids; /readyz and runtime reject malformed values.
OPERATOR_ACTOR_IDS=
GREENHOUSE_RECRUITER_DISABLE_OPERATOR_UNSCOPED=false

# Revocation and emergency controls.
GREENHOUSE_RECRUITER_REVOKED_TOKEN_IDS=
GREENHOUSE_RECRUITER_MCP_DISABLED=false
# Fail-closed exact model-facing catalog. The other 22 source readers remain hidden.
GREENHOUSE_RECRUITER_ALLOWED_TOOLS=answer_my_recruiting_question,analyze_scorecard_accountability,analyze_interview_feedback_drag,analyze_stage_latency,analyze_pipeline_quality,analyze_source_quality,analyze_rejection_reason_drift,resolve_job_scope,confirm_job_scope,get_job_scope,get_recruiting_capabilities,read_my_resume,search_my_jobs,get_my_job,search_my_applications,get_my_application,search_my_interviews,search_my_offers,search_my_openings,search_my_users,search_my_job_owners,search_my_job_interview_stages,search_my_application_stages,search_my_job_hiring_managers,search_my_job_posts,search_my_candidates,get_my_candidate,search_my_scorecards,search_my_rejection_details,search_my_rejection_reasons,search_my_notes,search_my_attachments,search_my_interviewers,search_my_scorecard_question_answers,search_my_candidate_educations,search_my_candidate_employments,get_my_user,search_my_sources,search_my_referrers,search_my_custom_field_options,search_my_custom_fields,search_my_departments,search_my_offices,search_my_close_reasons
GREENHOUSE_RECRUITER_DISABLE_EVIDENCE=false
GREENHOUSE_RECRUITER_DISABLE_ANALYTICS=false
GREENHOUSE_RECRUITER_DISABLE_CLAUDE_DESKTOP=false
GREENHOUSE_RECRUITER_DISABLE_CHATGPT_DESKTOP=false

# Fresh-per-read permissions for rollout. Keep TTL at zero unless a controlled pilot explicitly approves a short cache.
GREENHOUSE_RECRUITER_FORCE_PERMISSION_TTL_ZERO=true
GREENHOUSE_RECRUITER_PERMISSION_TTL_MS=0

# Runtime limits. Tune only after retained audit review and rollout gate evidence are green.
GREENHOUSE_RECRUITER_MAX_PER_PAGE=100
GREENHOUSE_RECRUITER_DEFAULT_PER_PAGE=50
GREENHOUSE_RECRUITER_MAX_LOOKBACK_DAYS=180
GREENHOUSE_RECRUITER_MAX_RANKINGS=50
GREENHOUSE_RECRUITER_MAX_TOOL_DURATION_MS=30000
GREENHOUSE_RECRUITER_MAX_ANALYSIS_DURATION_MS=120000
GREENHOUSE_RECRUITER_MAX_HTTP_BODY_BYTES=262144
GREENHOUSE_RECRUITER_HTTP_HEADERS_TIMEOUT_MS=10000
GREENHOUSE_RECRUITER_HTTP_REQUEST_TIMEOUT_MS=300000
GREENHOUSE_RECRUITER_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
GREENHOUSE_RECRUITER_RATE_LIMIT_DISABLED=false
GREENHOUSE_RECRUITER_RATE_LIMIT_WINDOW_MS=60000
GREENHOUSE_RECRUITER_MAX_CALLS_PER_WINDOW=120
GREENHOUSE_RECRUITER_MAX_ANALYSIS_CALLS_PER_WINDOW=30
