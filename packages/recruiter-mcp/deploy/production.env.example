# Greenhouse recruiter-scoped MCP production server environment.
# Copy this file into your host/orchestrator secret manager and replace placeholders there.
# Do not distribute this file to recruiters. Desktop configs contain only MCP URL + durable user token.

# HTTP listener. Cloud Run injects PORT and the runtime honors it ahead of this value, so this is the
# local fallback used only when PORT is unset. The Cloud Run image defaults it to 8080 too.
GREENHOUSE_RECRUITER_MCP_PORT=8080
GREENHOUSE_RECRUITER_MCP_PATH=/mcp
GREENHOUSE_RECRUITER_HEALTH_PATH=/healthz
GREENHOUSE_RECRUITER_READY_PATH=/readyz
GREENHOUSE_RECRUITER_READYZ_TOKEN=<replace-with-32-plus-character-readiness-bearer-token>

# Greenhouse Harvest organization client. Server-side only.
GREENHOUSE_CLIENT_ID=<greenhouse-client-id>
GREENHOUSE_CLIENT_SECRET=<greenhouse-client-secret>

# Durable session signing secret. Use at least 32 high-entropy characters with no surrounding whitespace.
GREENHOUSE_RECRUITER_SESSION_SECRET=<replace-with-32-plus-character-random-secret>

# Resolver scope artifact signing secret. Use at least 32 high-entropy characters with no surrounding whitespace.
GREENHOUSE_RECRUITER_SCOPE_SIGNING_SECRET=<replace-with-32-plus-character-random-secret>

# Production identity and revocation state backend. Only supabase_postgrest is implemented in this build.
GREENHOUSE_RECRUITER_STATE_BACKEND=supabase_postgrest

# This deployment's dedicated Supabase project ref (the <ref> in https://<ref>.supabase.co). Every
# Supabase URL below, and the action plane's, is asserted against it at runtime; left unset, the
# shaped placeholder exampleprojectref000 applies and every real project URL is refused.
GREENHOUSE_MCP_SUPABASE_PROJECT_REF=exampleprojectref000
# Optional: sibling projects to name in that refusal, as comma-separated ref=label pairs.
GREENHOUSE_MCP_SUPABASE_KNOWN_WRONG_PROJECTS=

# Production identity directory. Server-side only; static GREENHOUSE_RECRUITER_IDENTITY_JSON is for local development and tests only.
# URL is the canonical Greenhouse MCP project (asserted at runtime). The key must have no surrounding
# whitespace and must be an RLS-bypassing key — a service_role JWT or an sb_secret_ key. The tables have
# row-level security enabled, so an anon/publishable key would read empty results. Table/column overrides
# must be simple identifiers.
GREENHOUSE_RECRUITER_IDENTITY_SUPABASE_URL=https://exampleprojectref000.supabase.co
GREENHOUSE_RECRUITER_IDENTITY_SUPABASE_KEY=<supabase-service-role-or-sb_secret_-key>
GREENHOUSE_RECRUITER_IDENTITY_TABLE=recruiter_identity_directory
GREENHOUSE_RECRUITER_IDENTITY_LOOKUP_TIMEOUT_MS=5000

# Production durable-session revocation source. Server-side only; stores token ids, never token strings.
# URL is the canonical Greenhouse MCP project (asserted at runtime). The key must have no surrounding
# whitespace and must be an RLS-bypassing key — a service_role JWT or an sb_secret_ key — because the
# revocation table has row-level security enabled; an anon/publishable key would read empty results and
# silently fail the session kill-switch (revoked sessions would survive). Overrides must be simple identifiers.
GREENHOUSE_RECRUITER_REVOCATION_SUPABASE_URL=https://exampleprojectref000.supabase.co
GREENHOUSE_RECRUITER_REVOCATION_SUPABASE_KEY=<supabase-service-role-or-sb_secret_-key>
GREENHOUSE_RECRUITER_REVOCATION_TABLE=recruiter_mcp_session_revocation
GREENHOUSE_RECRUITER_REVOCATION_LOOKUP_TIMEOUT_MS=5000

# Retained metadata-only audit sink. Mount/route this path to durable storage.
GREENHOUSE_RECRUITER_AUDIT_JSONL_PATH=/app/audit/audit.jsonl
# Declared durable mount for the audit sink. Readiness fails unless this is set and the audit path
# above resolves under it, so the audit path is routed to the declared durable volume rather than the
# ephemeral container filesystem (where a redeploy would lose the retained PII audit record). NOTE:
# readiness verifies this DECLARATION; confirm the volume is actually mounted at deploy (df / mount).
GREENHOUSE_RECRUITER_AUDIT_DURABLE_MOUNT_PATH=/app/audit

# --- GCS object audit backend (GREENHOUSE_RECRUITER_AUDIT_*) ---
# Alternative retained audit backend for hosts without an appendable durable mount — on Cloud Run a
# GCS FUSE mount cannot append a JSONL line (objects are immutable), so the file sink cannot serve
# there. Set BACKEND=gcs_object to retain one create-only JSON object per audit event under
# gs://<bucket>/<prefix>/<YYYY-MM>/; the two file-path variables above are then IGNORED. The runtime
# service account needs storage object create/get/list/delete on the bucket, and every /mcp request
# preflights a real probe write under <prefix>/.probe/. Empty or jsonl_file keeps the file sink;
# any other value fails closed everywhere (readiness, /mcp, sink selection) — an unrecognized
# backend never silently downgrades audit. BUCKET is the bucket name (a gs:// scheme and
# surrounding whitespace are normalized away; path segments are rejected); PREFIX is optional and
# defaults to audit. The gcs_object backend requires Node 22+ (the @google-cloud/storage SDK's own
# floor); the package's declared engines range is unchanged in this build — that flip is tracked
# separately.
GREENHOUSE_RECRUITER_AUDIT_BACKEND=
GREENHOUSE_RECRUITER_AUDIT_GCS_BUCKET=
GREENHOUSE_RECRUITER_AUDIT_GCS_PREFIX=

# Remote desktop/broker attachment controls. Unsupported surfaces or malformed origins fail closed.
GREENHOUSE_RECRUITER_REMOTE_SURFACES=chatgpt_desktop,claude_desktop
GREENHOUSE_RECRUITER_CORS_ORIGIN=https://chatgpt.com,https://claude.ai

# Operator unscoped passthrough. Leave empty unless an explicit operator allowlist is approved.
# If set, this must be comma-separated positive Greenhouse user ids; /readyz and runtime reject malformed values.
OPERATOR_ACTOR_IDS=
GREENHOUSE_RECRUITER_DISABLE_OPERATOR_UNSCOPED=false

# Revocation and emergency controls.
GREENHOUSE_RECRUITER_REVOKED_TOKEN_IDS=
GREENHOUSE_RECRUITER_MCP_DISABLED=false
# GREENHOUSE_RECRUITER_ALLOWED_TOOLS is GONE (R2a). It was a hand-maintained list of tool names that
# hid 22 built, tested readers behind a count with no reason, and it failed OPEN when unset, so it was
# never a control either. The catalog is now the registrar: every registered read tool is mounted.
# Remove a reader by naming it in GREENHOUSE_RECRUITER_DISABLE_TOOLS below, with a reason.
# DEPLOY STEP: delete GREENHOUSE_RECRUITER_ALLOWED_TOOLS from the Cloud Run service; it is ignored now,
# and leaving it there implies a control that no longer exists.
GREENHOUSE_RECRUITER_DISABLE_TOOLS=
GREENHOUSE_RECRUITER_DISABLE_EVIDENCE=false
GREENHOUSE_RECRUITER_DISABLE_ANALYTICS=false
GREENHOUSE_RECRUITER_DISABLE_CLAUDE_DESKTOP=false
GREENHOUSE_RECRUITER_DISABLE_CHATGPT_DESKTOP=false

# Fresh-per-read permissions by default. Keep TTL at zero unless a deployment explicitly configures a short cache.
GREENHOUSE_RECRUITER_FORCE_PERMISSION_TTL_ZERO=true
GREENHOUSE_RECRUITER_PERMISSION_TTL_MS=0

# Runtime limits. Tune only after retained audit review and rollout gate evidence are green.
GREENHOUSE_RECRUITER_MAX_PER_PAGE=100
GREENHOUSE_RECRUITER_DEFAULT_PER_PAGE=50
GREENHOUSE_RECRUITER_MAX_LOOKBACK_DAYS=180
GREENHOUSE_RECRUITER_MAX_RANKINGS=50
GREENHOUSE_RECRUITER_MAX_TOOL_DURATION_MS=30000
GREENHOUSE_RECRUITER_MAX_ANALYSIS_DURATION_MS=120000
GREENHOUSE_RECRUITER_MAX_HTTP_BODY_BYTES=262144
GREENHOUSE_RECRUITER_HTTP_HEADERS_TIMEOUT_MS=10000
GREENHOUSE_RECRUITER_HTTP_REQUEST_TIMEOUT_MS=300000
GREENHOUSE_RECRUITER_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
# Absolute drain budget once SIGTERM/SIGINT arrives, before the listener is force-closed. Keep it
# under Cloud Run's 10s SIGKILL boundary; the runtime caps it at 8000.
GREENHOUSE_RECRUITER_SHUTDOWN_GRACE_MS=7000
GREENHOUSE_RECRUITER_RATE_LIMIT_DISABLED=false
GREENHOUSE_RECRUITER_RATE_LIMIT_WINDOW_MS=60000
GREENHOUSE_RECRUITER_MAX_CALLS_PER_WINDOW=120
GREENHOUSE_RECRUITER_MAX_ANALYSIS_CALLS_PER_WINDOW=30

# --- Greenhouse write plane (GREENHOUSE_ACTION_*) ---
# Ships DORMANT: both switches default false, so a copied template never writes to Greenhouse. Enable
# only after per-human write tokens and the entitlement rows are in place. When enabled: SERVICE_ENABLED
# mounts the write tools, WRITES_ENABLED lets them execute, SIGNING_SECRET signs write intents,
# SUPABASE_URL/KEY point at the entitlement store, CLIENT_ID/SECRET are the write-scoped Greenhouse app,
# and CAPABILITIES is the write-tool catalog. Leaving these empty keeps the plane dark.
GREENHOUSE_ACTION_SERVICE_ENABLED=false
GREENHOUSE_ACTION_WRITES_ENABLED=false
GREENHOUSE_ACTION_SIGNING_SECRET=
GREENHOUSE_ACTION_SUPABASE_URL=
GREENHOUSE_ACTION_SUPABASE_KEY=
GREENHOUSE_ACTION_CLIENT_ID=
GREENHOUSE_ACTION_CLIENT_SECRET=
GREENHOUSE_ACTION_CAPABILITIES=

# --- OAuth sign-in layer (GREENHOUSE_RECRUITER_OAUTH_*) ---
# Additive and all-or-nothing: with the whole family empty, every OAuth route stays dark and runtime
# behavior is unchanged. Set the family together to make the server its own authorization server that
# delegates identity to Google sign-in; a partial set fails the oauth_authorization readiness check on
# purpose. SIGNING_SECRET must differ from GREENHOUSE_RECRUITER_SESSION_SECRET, and the layer also
# needs GREENHOUSE_RECRUITER_ALLOWED_EMAIL_DOMAINS set. Read exact names from src/oauth-config.ts.
GREENHOUSE_RECRUITER_OAUTH_SIGNING_SECRET=
GREENHOUSE_RECRUITER_OAUTH_ISSUER=
GREENHOUSE_RECRUITER_OAUTH_RESOURCE_URL=
GREENHOUSE_RECRUITER_OAUTH_GOOGLE_CLIENT_ID=
GREENHOUSE_RECRUITER_OAUTH_GOOGLE_CLIENT_SECRET=
GREENHOUSE_RECRUITER_OAUTH_STATIC_CLIENT_ID=
GREENHOUSE_RECRUITER_OAUTH_STATIC_CLIENT_REDIRECT_URIS=
GREENHOUSE_RECRUITER_OAUTH_SUPABASE_URL=
GREENHOUSE_RECRUITER_OAUTH_SUPABASE_KEY=
GREENHOUSE_RECRUITER_OAUTH_SUPABASE_TABLE=
GREENHOUSE_RECRUITER_OAUTH_LOOKUP_TIMEOUT_MS=
GREENHOUSE_RECRUITER_ALLOWED_EMAIL_DOMAINS=
# First sign-in enrolls a colleague automatically when their verified work email matches exactly one
# ACTIVE Greenhouse user and no directory row exists for them yet (the same rules as
# greenhouse-recruiter-bootstrap-identity). Set to "true" to fall back to the hand-maintained
# directory as an allowlist; unset/false = enrollment on. Never overrides an existing row.
GREENHOUSE_RECRUITER_OAUTH_DISABLE_AUTO_ENROLL=false
# Who a refused sign-in should contact, shown verbatim in the denial copy (e.g. "Ask #recruiting-ops").
GREENHOUSE_RECRUITER_SUPPORT_CONTACT=
